<Window x:Class="ApexAstro.Wpf.TemporalSnrPreflightDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compute SNR"
        Width="684"
        MinWidth="630"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource ThemeWindowBackground}"
        Foreground="{DynamicResource ThemeForeground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="This will compute a pixel-by-pixel SNR map for the current folder."
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"
                   TextWrapping="Wrap"/>

        <Border Grid.Row="1"
                Background="{DynamicResource ThemeControlBackground}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Estimated run time"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <TextBlock Text="{Binding EstimateText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding HardwareText}" TextWrapping="Wrap" Foreground="{DynamicResource ThemeSecondaryText}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource ThemeControlBackground}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Current folder SNR"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <TextBlock Text="{Binding CurrentResultsSummaryText}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <Border Visibility="{Binding HasCurrentResults, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="{DynamicResource ThemeSidebarBackground}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8"
                        Margin="0,0,0,6">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="95"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0"
                                       Grid.Column="4"
                                       Grid.ColumnSpan="3"
                                       Text="Additional time to reach target SNR (hours)"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       HorizontalAlignment="Stretch"
                                       TextAlignment="Center"
                                       Margin="0,0,0,3"/>

                            <TextBlock Grid.Row="1" Text="Filter" FontWeight="Bold" FontSize="12" Grid.Column="0"/>
                            <TextBlock Grid.Row="1" Text="Frames" FontWeight="Bold" FontSize="12" TextAlignment="Right" Grid.Column="1"/>
                            <TextBlock Grid.Row="1" Text="Time(HH:MM)" FontWeight="Bold" FontSize="12" TextAlignment="Right" Grid.Column="2"/>
                            <TextBlock Grid.Row="1" Text="SNR" FontWeight="Bold" FontSize="12" TextAlignment="Right" Grid.Column="3" Margin="0,0,12,0"/>
                            <TextBlock Grid.Row="1" Text="SNR 30" FontWeight="Bold" FontSize="12" TextAlignment="Center" Grid.Column="4"/>
                            <TextBlock Grid.Row="1" Text="SNR 60" FontWeight="Bold" FontSize="12" TextAlignment="Center" Grid.Column="5"/>
                            <TextBlock Grid.Row="1" Text="SNR 90" FontWeight="Bold" FontSize="12" TextAlignment="Center" Grid.Column="6"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding CurrentResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="95"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding FilterName}" Grid.Column="0"/>
                                        <TextBlock Text="{Binding FrameCount}" TextAlignment="Right" Grid.Column="1"/>
                                        <TextBlock Text="{Binding IntegrationMinutesDisplay}" TextAlignment="Right" Grid.Column="2"/>
                                        <TextBlock Text="{Binding MedianTemporalSnr, StringFormat={}{0:F0}}" TextAlignment="Right" Grid.Column="3" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding AdditionalTo30Display}" TextAlignment="Center" Grid.Column="4"/>
                                        <TextBlock Text="{Binding AdditionalTo60Display}" TextAlignment="Center" Grid.Column="5"/>
                                        <TextBlock Text="{Binding AdditionalTo90Display}" TextAlignment="Center" Grid.Column="6"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding ComputeStepsText}"
                           Visibility="{Binding ShowComputeSteps, Converter={StaticResource BooleanToVisibilityConverter}}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Background="{DynamicResource ThemeControlBackground}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Options"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <CheckBox Content="Use the full machine"
                          IsChecked="{Binding UseFullMachine, Mode=TwoWay}"
                          Margin="0,2"/>
                <CheckBox Content="Save intermediate data for future reuse"
                          IsChecked="{Binding SaveIntermediateData, Mode=TwoWay}"
                          Margin="0,2"/>
                <CheckBox Content="Stop immediately if any frame is mismatched"
                          IsChecked="{Binding StopOnMismatch, Mode=TwoWay}"
                          Margin="0,2"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Start" Width="120" IsDefault="True" Click="StartCompute_Click"/>
        </StackPanel>
    </Grid>
</Window>

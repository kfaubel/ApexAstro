<Window x:Class="ApexAstro.Wpf.TemporalSnrProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Computing Temporal SNR"
        Width="540"
        MinWidth="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ThemeWindowBackground}"
        Foreground="{DynamicResource ThemeForeground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding StatusText}"
                   FontSize="15"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1"
                   Text="{Binding ResultText}"
                   Visibility="{Binding HasResultText, Converter={StaticResource BooleanToVisibilityConverter}}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <Border Grid.Row="2"
            Visibility="{Binding HasFilterSummaries, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="{DynamicResource ThemeSidebarBackground}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Per-filter SNR"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Filter" FontWeight="SemiBold" Grid.Column="0"/>
                    <TextBlock Text="Median" FontWeight="SemiBold" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock Text="Mean" FontWeight="SemiBold" Grid.Column="2" TextAlignment="Right"/>
                    <TextBlock Text="StdDev" FontWeight="SemiBold" Grid.Column="3" TextAlignment="Right"/>
                    <TextBlock Text="CV" FontWeight="SemiBold" Grid.Column="4" TextAlignment="Right"/>
                    <TextBlock Text="Grade" FontWeight="SemiBold" Grid.Column="5" TextAlignment="Center"/>
                    <TextBlock Text="Target" FontWeight="SemiBold" Grid.Column="6" TextAlignment="Left"/>
                    <TextBlock Text="Frames" FontWeight="SemiBold" Grid.Column="7" TextAlignment="Right"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding FilterSummaries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding FilterName}" Grid.Column="0"/>
                                <TextBlock Text="{Binding MedianTemporalSnr, StringFormat={}{0:F2}}" Grid.Column="1" TextAlignment="Right"/>
                                <TextBlock Text="{Binding MeanTemporalSnr, StringFormat={}{0:F2}}" Grid.Column="2" TextAlignment="Right"/>
                                <TextBlock Text="{Binding StandardDeviationTemporalSnr, StringFormat={}{0:F2}}" Grid.Column="3" TextAlignment="Right"/>
                                <TextBlock Text="{Binding CvDisplay}" Grid.Column="4" TextAlignment="Right"/>
                                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Fill="{Binding CvGradeBrush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding CvGrade}" Foreground="{Binding CvGradeBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding TargetDataGuidance}" Grid.Column="6"/>
                                <TextBlock Text="{Binding FrameCount}" Grid.Column="7" TextAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="Overall progress"
                       FontWeight="SemiBold"
                       Margin="0,0,0,3"/>
            <ProgressBar Height="20"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding TotalProgressValue, Mode=OneWay}"
                         Margin="0,0,0,3"/>
            <TextBlock Text="{Binding PercentText}"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock Text="{Binding CurrentFilterText}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,3"/>
            <ProgressBar Height="18"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding FilterProgressValue, Mode=OneWay}"
                         Margin="0,0,0,3"/>
            <TextBlock Text="{Binding FilterPercentText}"/>
        </StackPanel>

        <DockPanel Grid.Row="5" Margin="0,0,0,10">
            <TextBlock Text="{Binding PercentText}" DockPanel.Dock="Left"/>
            <TextBlock Text="{Binding EtaText}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
        </DockPanel>

        <ItemsControl Grid.Row="6" ItemsSource="{Binding Steps}" Margin="0,0,0,12">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding DisplayText}"
                              IsChecked="{Binding IsCompleted}"
                              IsEnabled="False"
                              Margin="0,2"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button x:Name="CloseButton" Content="Close" Width="90" Visibility="Collapsed" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

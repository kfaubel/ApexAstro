<Window x:Class="ApexAstro.Wpf.TemporalSnrProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Computing SNR"
        Width="980"
        MinWidth="980"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ThemeWindowBackground}"
        Foreground="{DynamicResource ThemeForeground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding StatusText}"
                   FontSize="15"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1"
                   Text="{Binding ResultText}"
                   Visibility="{Binding HasResultText, Converter={StaticResource BooleanToVisibilityConverter}}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <Border Grid.Row="2"
            Visibility="{Binding HasFilterSummaries, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="{DynamicResource ThemeSidebarBackground}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Per-filter SNR"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="95"/>
                        <ColumnDefinition Width="95"/>
                        <ColumnDefinition Width="95"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0"
                               Grid.Column="4"
                               Grid.ColumnSpan="3"
                               Text="Additional time to reach target SNR (hours)"
                               FontWeight="Bold"
                               FontSize="13"
                               HorizontalAlignment="Stretch"
                               TextAlignment="Center"
                               Margin="0,0,0,3"/>

                    <TextBlock Grid.Row="1" Text="Filter" FontWeight="Bold" FontSize="12" Grid.Column="0"/>
                    <TextBlock Grid.Row="1" Text="Frames" FontWeight="Bold" FontSize="12" Grid.Column="1" TextAlignment="Right"/>
                    <TextBlock Grid.Row="1" Text="Time(HH:MM)" FontWeight="Bold" FontSize="12" Grid.Column="2" TextAlignment="Right"/>
                    <TextBlock Grid.Row="1" Text="SNR" FontWeight="Bold" FontSize="12" Grid.Column="3" TextAlignment="Right" Margin="0,0,12,0"/>
                    <TextBlock Grid.Row="1" Text="SNR 30" FontWeight="Bold" FontSize="12" Grid.Column="4" TextAlignment="Center"/>
                    <TextBlock Grid.Row="1" Text="SNR 60" FontWeight="Bold" FontSize="12" Grid.Column="5" TextAlignment="Center"/>
                    <TextBlock Grid.Row="1" Text="SNR 90" FontWeight="Bold" FontSize="12" Grid.Column="6" TextAlignment="Center"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding FilterSummaries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="85"/>
                                    <ColumnDefinition Width="84"/>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="95"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding FilterName}" Grid.Column="0"/>
                                <TextBlock Text="{Binding FrameCount}" Grid.Column="1" TextAlignment="Right"/>
                                <TextBlock Text="{Binding IntegrationMinutesDisplay}" Grid.Column="2" TextAlignment="Right"/>
                                <TextBlock Text="{Binding MedianTemporalSnr, StringFormat={}{0:F0}}" Grid.Column="3" TextAlignment="Right" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding AdditionalTo30Display}" Grid.Column="4" TextAlignment="Center"/>
                                <TextBlock Text="{Binding AdditionalTo60Display}" Grid.Column="5" TextAlignment="Center"/>
                                <TextBlock Text="{Binding AdditionalTo90Display}" Grid.Column="6" TextAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="Overall progress"
                       FontWeight="SemiBold"
                       Margin="0,0,0,3"/>
            <ProgressBar Height="20"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding TotalProgressValue, Mode=OneWay}"
                         Margin="0,0,0,3"/>
            <TextBlock Text="{Binding PercentText}"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock Text="{Binding CurrentFilterText}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,3"/>
            <ProgressBar Height="18"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding FilterProgressValue, Mode=OneWay}"
                         Margin="0,0,0,3"/>
            <TextBlock Text="{Binding FilterPercentText}"/>
        </StackPanel>

        <DockPanel Grid.Row="5" Margin="0,0,0,10">
            <TextBlock Text="{Binding PercentText}" DockPanel.Dock="Left"/>
            <TextBlock Text="{Binding EtaText}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
        </DockPanel>

        <ItemsControl Grid.Row="6" ItemsSource="{Binding Steps}" Margin="0,0,0,12">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="✓"
                                   Width="18"
                                   Foreground="{DynamicResource ThemeAccentGreen}"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                    <Setter Property="Text" Value="✓"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Opacity" Value="1.0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button x:Name="CloseButton" Content="Close" Width="90" Visibility="Collapsed" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

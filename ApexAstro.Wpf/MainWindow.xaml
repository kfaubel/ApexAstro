<Window x:Class="ApexAstro.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ApexAstro.Wpf"
        Title="{Binding WindowTitle}" Height="720" Width="1200" 
        MinWidth="800" MinHeight="600" 
        Icon="icon.ico"
        Background="{DynamicResource ThemeWindowBackground}"
        Foreground="{DynamicResource ThemeForeground}">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl+Shift" Command="{Binding OpenFolderDialogCommand}" />
        <KeyBinding Key="Home" Command="{Binding GotoFirstCommand}" />
        <KeyBinding Key="End" Command="{Binding GotoLastCommand}" />
        <KeyBinding Key="PageUp" Command="{Binding GotoPreviousCommand}" />
        <KeyBinding Key="PageDown" Command="{Binding GotoNextCommand}" />
        <KeyBinding Key="Space" Command="{Binding PlayPauseCommand}" />
        <KeyBinding Key="A" Modifiers="Ctrl" Command="{Binding SelectAllCommand}" />
        <KeyBinding Key="F11" Command="{Binding EnterFullScreenCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Ctrl" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Ctrl" Command="{Binding ZoomOutCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0"
              Background="{DynamicResource ThemeToolbarBackground}"
              Foreground="{DynamicResource ThemeForeground}">
            <MenuItem Header="_File">
                <MenuItem Header="Open Folder..."
                          InputGestureText="Ctrl+Shift+O"
                          Command="{Binding OpenFolderDialogCommand}"/>
                <MenuItem x:Name="OpenRecentMenuItem"
                          Header="Open Recent  >"
                          SubmenuOpened="OpenRecentMenuItem_SubmenuOpened">
                    <MenuItem Header="(No recent folders)" IsEnabled="False"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </MenuItem>

            <MenuItem Header="_Options">
                <MenuItem Header="General..." Command="{Binding ShowGeneralOptionsDialogCommand}"/>
                <MenuItem Header="FITS Keywords..." Command="{Binding ShowFitsKeywordsDialogCommand}"/>
                <MenuItem Header="Custom Keywords..." Command="{Binding ShowCustomKeywordsDialogCommand}"/>
                <MenuItem Header="Session Metadata..." Click="SessionMetadataMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Quality Criteria..." Click="AutoSelectButton_Click"/>
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="Fit to Window" Command="{Binding FitToWindowCommand}"/>
                <MenuItem Header="Zoom In" InputGestureText="Ctrl++" Command="{Binding ZoomInCommand}"/>
                <MenuItem Header="Zoom Out" InputGestureText="Ctrl+-" Command="{Binding ZoomOutCommand}"/>
                <MenuItem Header="Actual Size" Command="{Binding ZoomActualCommand}"/>
                <Separator/>
                <MenuItem Header="Graph..." Click="ShowGraph_Click"/>
                <MenuItem Header="Toggle Histogram" Click="ToggleHistogramMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Full Screen" InputGestureText="F11" Command="{Binding EnterFullScreenCommand}"/>
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="Documentation" Click="Documentation_Click"/>
                <MenuItem Header="View Log" Click="ViewLog_Click"/>
                <MenuItem Header="About" Click="About_Click"/>
            </MenuItem>
        </Menu>
        
        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource ThemeToolbarBackground}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="4,2">
            <Grid>
                <!-- Right-aligned buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Re-dock Button (visible only when floating) -->
                    <Button Name="RedockButton"
                            Click="RedockButton_Click" 
                            ToolTip="Dock image and histogram back to main window"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Margin="2,0"
                            Visibility="Collapsed">
                        <Path Data="M4,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M4,6V18H11V6H4M20,18V6H18V18H20M13,6V18H16V6H13Z" 
                              Fill="{DynamicResource ThemeButtonForeground}" 
                              Width="20" Height="20" 
                              Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="FileListColumn" Width="3*" MinWidth="200"/>
                <ColumnDefinition Name="SplitterColumn" Width="Auto"/>
                <ColumnDefinition Name="ImageColumn" Width="1*" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid Grid.Column="0" Background="{DynamicResource ThemeSidebarBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Control Section - At Top -->
                <Grid Grid.Row="0" Margin="8,8,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Delete Selected Button - Left Aligned -->
                    <Button Name="DeleteSelectedButton" Grid.Column="0" Content="Delete marked" 
                            Click="DeleteSelectedButton_Click" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,4,4,4"
                            ToolTip="Delete Files&#10;Move selected files to the Recycle Bin" />
                    
                    <!-- Move Selected Button - Left Aligned -->
                    <Button Name="MoveSelectedButton" Grid.Column="1" Content="Move marked..." 
                            Click="MoveSelectedButton_Click" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,4,4,4"
                            ToolTip="Move Files&#10;Move marked files to a folder or the Recycle Bin" />
                    
                    <!-- Select All Button -->
                    <Button Name="SelectAllButton" Grid.Column="2" Content="Mark all" 
                            Click="SelectAllButton_Click" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,4,4,4" 
                            ToolTip="Select All (Ctrl+A)&#10;Select all files in the list"/>
                    
                    <!-- Clear All Button -->
                    <Button Name="ClearAllButton" Grid.Column="3" Content="Clear All" 
                            Click="ClearAllButton_Click" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,4,8,4" 
                            ToolTip="Clear all selections"/>

                        <ToggleButton Grid.Column="5"
                                      HorizontalAlignment="Right"
                                      Margin="8,0,2,0"
                                      VerticalAlignment="Center"
                                      FontSize="14"
                                      FontWeight="SemiBold"
                                      IsChecked="{Binding IsDirectoryReviewed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanMarkDirectoryReviewed}"
                                      Content="{Binding DirectoryReviewedStatusText}"
                                      ToolTip="Click to mark this folder as reviewed">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="#1F6FEB" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Padding" Value="12,6" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="3"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      RecognizesAccessKey="True"
                                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeButtonBackgroundHover}" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeButtonBackgroundPressed}" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Background" Value="#2E8B57" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.5" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                </Grid>
                
                <!-- File List with Scrollbar -->
                <ListView Name="FileListView" Grid.Row="1" Margin="4,0,4,4" FontSize="13"
                          Background="{DynamicResource ThemeListViewBackground}"
                          Foreground="{DynamicResource ThemeForeground}"
                          BorderBrush="{DynamicResource ThemeBorderBrush}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                            <Setter Property="ToolTip" Value="{Binding Name}"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.SelectedIndex>
                        <Binding Path="SelectedIndex" Mode="TwoWay"/>
                    </ListView.SelectedIndex>
                    <ListView.View>
                        <GridView AllowsColumnReorder="True">
                            <!-- Dynamic columns are created in code-behind -->
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <!-- Resize / Handle -->
            <GridSplitter Name="ColumnSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#DDD" />

            <!-- Main Content -->
            <Grid Name="ImageContentGrid" Grid.Column="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="200"/>
                    <RowDefinition Name="HistogramSplitterRow" Height="Auto"/>
                    <RowDefinition Name="HistogramRow" Height="200"/>
                </Grid.RowDefinitions>

                <!-- Image View Controls -->
                <Grid Name="ImageControlsGrid" Grid.Row="0" Margin="8,8,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" HorizontalAlignment="Left">
                            <Button Content="-" Width="40" Margin="4" Command="{Binding ZoomOutCommand}" ToolTip="Zoom out (Ctrl+-)" />
                            <Button Content="+" Width="40" Margin="4" Command="{Binding ZoomInCommand}" ToolTip="Zoom in (Ctrl++)" />
                            <Button Content="1:1" Width="50" Margin="4" Command="{Binding ZoomActualCommand}" ToolTip="Zoom to 100%" />
                            <Button Content="Fit" Width="50" Margin="4" Command="{Binding FitToWindowCommand}" ToolTip="Fit to Window&#10;Scale image to fit current view" />
                            <TextBlock Text="{Binding ZoomDisplayText}" VerticalAlignment="Center" Margin="8"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="Stretch:" VerticalAlignment="Center" Margin="4,0,6,0"/>
                                <Slider Minimum="0" Maximum="10" SmallChange="1" LargeChange="1" TickFrequency="1"
                                        IsSnapToTickEnabled="True" Width="140"
                                        Value="{Binding StretchAggressiveness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        VerticalAlignment="Center"
                                        ToolTip="Stretch aggressiveness"/>
                                <TextBlock Text="{Binding StretchDisplayText}"
                                           VerticalAlignment="Center"
                                           Width="28"
                                           TextAlignment="Center"
                                           Margin="6,0,0,0"/>
                            </StackPanel>

                            <Button Width="36" Height="32" Margin="4"
                                    Click="FloatButton_Click"
                                    ToolTip="Float Windows&#10;Detach image and histogram panes">
                                <Path Data="M2,4V16H10V20H22V8H14V4H2M4,6H12V14H4V6M14,10H20V18H12V16H14V10Z"
                                      Fill="{DynamicResource ThemeButtonForeground}"
                                      Stretch="Uniform"
                                      Width="18" Height="18"/>
                            </Button>
                            <Button Width="36" Height="32" Margin="4"
                                    Command="{Binding EnterFullScreenCommand}"
                                    ToolTip="Full Screen (F11)&#10;Toggle full-screen slideshow mode">
                                <Path Data="M5,5H10V7H7V10H5V5M14,5H19V10H17V7H14V5M17,14H19V19H14V17H17V14M10,17V19H5V14H7V17H10Z"
                                      Fill="{DynamicResource ThemeButtonForeground}"
                                      Stretch="Uniform"
                                      Width="18" Height="18"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <Button Name="GotoFirst" Width="40" Margin="2" Command="{Binding GotoFirstCommand}" ToolTip="Go to first image (Home)">
                            <Grid Width="20" Height="16">
                                <Rectangle Width="2" Height="14" Fill="{DynamicResource ThemeButtonForeground}" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                                <Path Width="12" Height="14" Stretch="Uniform" Fill="{DynamicResource ThemeButtonForeground}" Data="M 10,2 L 2,8 L 10,14 Z" HorizontalAlignment="Right" Margin="0,0,2,0"/>
                            </Grid>
                        </Button>
                        <Button Name="GotoPrevious" Width="40" Margin="2" Command="{Binding GotoPreviousCommand}" ToolTip="Go to previous image (Page Up)">
                            <Path Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource ThemeButtonForeground}" Data="M 15,2 L 5,10 L 15,18" />
                        </Button>
                        <Button Name="PlayPause" Width="40" Margin="2" Command="{Binding PlayPauseCommand}" ToolTip="Play / pause slideshow (Space)">
                            <ContentControl>
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <Path Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource ThemeButtonForeground}" Data="M 6,4 L 18,10 L 6,16 Z" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <Grid Width="16" Height="16">
                                                            <Rectangle Width="5" Height="14" Fill="{DynamicResource ThemeButtonForeground}" RadiusX="1" RadiusY="1" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                                                            <Rectangle Width="5" Height="14" Fill="{DynamicResource ThemeButtonForeground}" RadiusX="1" RadiusY="1" HorizontalAlignment="Right" Margin="0,0,2,0"/>
                                                        </Grid>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </Button>
                        <Button Name="GotoNext" Width="40" Margin="2" Command="{Binding GotoNextCommand}" ToolTip="Go to next image (Page Down)">
                            <Path Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource ThemeButtonForeground}" Data="M 5,2 L 15,10 L 5,18" />
                        </Button>
                        <Button Name="GotoLast" Width="40" Margin="2" Command="{Binding GotoLastCommand}" ToolTip="Go to last image (End)">
                            <Grid Width="20" Height="16">
                                <Path Width="12" Height="14" Stretch="Uniform" Fill="{DynamicResource ThemeButtonForeground}" Data="M 2,2 L 10,8 L 2,14 Z" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                                <Rectangle Width="2" Height="14" Fill="{DynamicResource ThemeButtonForeground}" HorizontalAlignment="Right" Margin="0,0,2,0"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Border Background="{DynamicResource ThemeImageAreaBackground}" Margin="4" CornerRadius="4">
                        <Grid>
                            <TextBlock Name="PlaceholderText" Text="Select an image from the file list" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ScrollViewer Name="ImageScrollViewer"
                                         Visibility="Collapsed"
                                         HorizontalScrollBarVisibility="{Binding ScrollBarVisibility}"
                                         VerticalScrollBarVisibility="{Binding ScrollBarVisibility}"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel">
                                <Image Name="DisplayImage"
                                       Stretch="None"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RenderTransformOrigin="0,0"
                                       MouseLeftButtonDown="DisplayImage_MouseLeftButtonDown"
                                       MouseLeftButtonUp="DisplayImage_MouseLeftButtonUp"
                                       MouseMove="DisplayImage_MouseMove"
                                       RenderOptions.BitmapScalingMode="Fant">
                                    <Image.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}" />
                                    </Image.RenderTransform>
                                </Image>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
                
                <!-- Resize Handle for Histogram -->
                <GridSplitter Name="HistogramSplitter" Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#DDD" />
                
                <!-- Histogram Panel -->
                <local:HistogramControl Grid.Row="3" x:Name="HistogramControl" Margin="4,0,4,4"/>
            </Grid>
        </Grid>
        
        <!-- Status Bar -->
        <StatusBar Grid.Row="3" 
                   Background="{DynamicResource ThemeWindowBackground}"
                   BorderBrush="{DynamicResource ThemeBorderBrush}"
                   BorderThickness="0,1,0,0"
                   Padding="8,4">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarText}" 
                           FontSize="13"
                           Foreground="{DynamicResource ThemeForeground}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TemporalSnrStatusText}"
                               FontSize="13"
                               Foreground="{DynamicResource ThemeForeground}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
<Window x:Class="ApexAstro.Wpf.ImageCaptureFormatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Capture Format"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="icon.ico"
        Background="{DynamicResource ThemeWindowBackground}"
        Foreground="{DynamicResource ThemeForeground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Choose your image capture format"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1"
                   Text="ApexAstro can pre-configure columns and metadata headers for your workflow."
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <Button Content="N.I.N.A." Height="34" Margin="0,0,0,8" Click="Nina_Click"/>
            <Button Content="ASIAIR" Height="34" Margin="0,0,0,8" Click="Asiair_Click"/>
            <Button Content="Let me choose later" Height="34" Click="ChooseLater_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Text="You can change this anytime in Options > Reset Settings."
                   Opacity="0.8"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
